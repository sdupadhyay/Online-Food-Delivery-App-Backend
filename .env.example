# Application Environment
PROJECT_NAME="Online Food Delivery API"
ENVIRONMENT="development"

# Neon Cloud PostgreSQL Connection URL
# Copy your connection string from the Neon Console (Dashboard -> Connection Details)
# Example: postgresql://neondb_owner:npg_xxxx@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-your-neon-host.neon.tech/neondb?sslmode=require"

# JWT Authentication Settings
SECRET_KEY="change_this_to_a_random_secret_string_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
